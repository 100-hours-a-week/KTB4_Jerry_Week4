# talktalk 배포용 .env 템플릿 (EC2). 실제 파일(.env)은 커밋 금지.
# 백엔드는 prod 프로파일 + RDS. AWS 자격증명은 EC2 IAM Role이 처리하므로 키 불필요.

# ── Spring / DB (RDS) ──
SPRING_PROFILES_ACTIVE=prod
DB_HOST=<RDS 엔드포인트>
DB_NAME=talktalk
DB_USERNAME=<유저>
DB_PASSWORD=<비번>

# ── 앱 시크릿 ──
JWT_SECRET=<운영용 시크릿>

# ── S3 (이미지 업로드, IAM Role 사용 → 액세스 키 없음) ──
S3_BUCKET=talktalk-ktb
AWS_REGION=ap-northeast-2

# ── JVM 힙 상한 (1GB 인스턴스에서 blue/green 전환 시 backend 2벌이 메모리에 들어오게) ──
JAVA_TOOL_OPTIONS=-Xmx256m -XX:+UseSerialGC

# ── blue/green 이미지 태그 (deploy-backend.sh 가 자동 갱신 — 손으로 안 건드려도 됨) ──
BLUE_TAG=latest
GREEN_TAG=latest

# ── TLS 인증서 디렉토리 (fullchain.pem / privkey.pem 위치) ──
CERTS_DIR=/home/ubuntu/certs